@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="string" @bind-Value="_category" Label="Kategori"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var category in ScrumProjectViewModel.TaskCategories)
                    {
                        <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_title" Label="Task"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              MaxLength="250" Lines="3" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_owner" Label="PIC"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                           Disabled="@(!PicOptions.Any() && string.IsNullOrWhiteSpace(_owner))">
                    @if (!string.IsNullOrWhiteSpace(_owner) &&
                         !PicOptions.Contains(_owner, StringComparer.Ordinal))
                    {
                        <MudSelectItem T="string" Value="@_owner">PIC sebelumnya: @_owner</MudSelectItem>
                    }
                    @foreach (var pic in PicOptions)
                    {
                        <MudSelectItem T="string" Value="@pic">@pic</MudSelectItem>
                    }
                </MudSelect>
                @if (PicOptions.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        Belum ada Master PIC. Tambahkan PIC atau biarkan kosong.
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal?" @bind-Value="_estimatedHour" Label="Estimated Hour"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="0"
                                 Step="@(0.5m)" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_priority" Label="Prioritas"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var priority in ScrumProjectViewModel.Priorities)
                    {
                        <MudSelectItem T="string" Value="@priority">@priority</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_status" Label="Status"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var status in ScrumProjectViewModel.TaskStatuses)
                    {
                        <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_notes" Label="Notes"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_includeBlocker" Label="Tambahkan blocker" />
            </MudItem>
            @if (_includeBlocker)
            {
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_blockerTitle" Label="Judul blocker"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  MaxLength="250" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_blockerDetail" Label="Detail blocker"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  Lines="3" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_blockerOwner" Label="PIC blocker"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                               Disabled="@(!PicOptions.Any())">
                        @foreach (var pic in PicOptions)
                        {
                            <MudSelectItem T="string" Value="@pic">@pic</MudSelectItem>
                        }
                    </MudSelect>
                    @if (PicOptions.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">
                            Belum ada Master PIC. Tambahkan PIC atau biarkan kosong.
                        </MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_blockerNextStep" Label="Tindak lanjut blocker"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  Lines="2" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ScrumTaskRow? InitialValue { get; set; }
    [Parameter] public int SprintId { get; set; }
    [Parameter] public IReadOnlyList<string> PicOptions { get; set; } = [];
    [Parameter] public string DialogTitle { get; set; } = "Tambah Task";

    private string _title = string.Empty;
    private string _owner = string.Empty;
    private string _category = string.Empty;
    private string _priority = "Sedang";
    private string _status = "Belum dimulai";
    private decimal? _estimatedHour;
    private string _notes = string.Empty;
    private bool _includeBlocker;
    private string _blockerTitle = string.Empty;
    private string _blockerDetail = string.Empty;
    private string _blockerOwner = string.Empty;
    private string _blockerNextStep = string.Empty;

    protected override void OnInitialized()
    {
        if (InitialValue is not { } task)
        {
            return;
        }

        _title = task.Title;
        _owner = task.Owner;
        _category = task.Category ?? string.Empty;
        _priority = task.Priority;
        _status = task.Status;
        _estimatedHour = task.EstimatedHour;
        _notes = task.Notes ?? string.Empty;
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_category) ||
            (_includeBlocker &&
             (string.IsNullOrWhiteSpace(_blockerTitle) ||
              string.IsNullOrWhiteSpace(_blockerDetail) ||
              string.IsNullOrWhiteSpace(_blockerNextStep))))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ScrumTaskInput(
            InitialValue?.Id,
            SprintId,
            _title,
            _owner,
            _category,
            _priority,
            _status,
            _estimatedHour,
            _notes,
            _includeBlocker
                ? new ScrumBlockerInput(
                    null,
                    SprintId,
                    _blockerTitle,
                    _blockerDetail,
                    _blockerOwner,
                    _blockerNextStep,
                    false)
                : null)));
    }

    private void Cancel() => MudDialog.Cancel();
}
