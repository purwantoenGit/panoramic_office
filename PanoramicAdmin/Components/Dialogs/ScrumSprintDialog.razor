@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="int?" @bind-Value="_productBacklogItemId"
                           Label="Product Backlog Item" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Required="true" Disabled="@(!ProductBacklogItems.Any())">
                    @foreach (var item in ProductBacklogItems)
                    {
                        <MudSelectItem T="int?" Value="@((int?)item.Id)">
                            @item.Code · @item.Summary
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (ProductBacklogItems.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        Tambahkan Product Backlog Item terlebih dahulu.
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_focus" Label="Fokus sprint"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="250" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Date="@_startDate" DateChanged="OnStartDateChanged" Label="Tanggal mulai"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Date="@_endDate" DateChanged="OnEndDateChanged" Label="Tanggal selesai"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                               MinDate="@_startDate" MaxDate="@MaxEndDate" Disabled="@(_startDate is null)"
                               HelperText="Maksimal 14 hari termasuk tanggal mulai." />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="string" @bind-Value="_status" Label="Status"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var status in ScrumProjectViewModel.SprintStatuses)
                    {
                        <MudSelectItem T="string" Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_validationMessage is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">@_validationMessage</MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ScrumSprintRow? InitialValue { get; set; }
    [Parameter] public IReadOnlyList<ScrumProductBacklogItemOption> ProductBacklogItems { get; set; } = [];
    [Parameter] public int? DefaultProductBacklogItemId { get; set; }
    [Parameter] public string DialogTitle { get; set; } = "Tambah Sprint";

    private int? _productBacklogItemId;
    private string _focus = string.Empty;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddDays(13);
    private string _status = "Direncanakan";
    private string? _validationMessage;
    private DateTime? MaxEndDate => _startDate?.Date.AddDays(13);

    protected override void OnInitialized()
    {
        if (InitialValue is not { } sprint)
        {
            _productBacklogItemId = DefaultProductBacklogItemId;
            return;
        }

        _productBacklogItemId = sprint.ProductBacklogItemId;
        _focus = sprint.Focus;
        _startDate = sprint.StartDate;
        _endDate = sprint.EndDate;
        _status = sprint.Status;
    }

    private void Save()
    {
        if (_productBacklogItemId is not { } productBacklogItemId ||
            !ProductBacklogItems.Any(item => item.Id == productBacklogItemId) ||
            string.IsNullOrWhiteSpace(_focus) ||
            _startDate is not { } startDate || _endDate is not { } endDate)
        {
            _validationMessage = "Pilih Product Backlog Item dan isi fokus serta tanggal sprint.";
            return;
        }

        if (endDate.Date < startDate.Date || endDate.Date > startDate.Date.AddDays(13))
        {
            _validationMessage = "Tanggal selesai harus berada dalam rentang 14 hari dari tanggal mulai.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ScrumSprintInput(
            InitialValue?.Id,
            productBacklogItemId,
            _focus,
            startDate,
            endDate,
            _status)));
    }

    private void OnStartDateChanged(DateTime? value)
    {
        _startDate = value?.Date;
        if (_startDate is { } startDate &&
            (_endDate is not { } endDate ||
             endDate.Date < startDate.Date ||
             endDate.Date > startDate.Date.AddDays(13)))
        {
            _endDate = startDate.AddDays(13);
        }
    }

    private void OnEndDateChanged(DateTime? value) => _endDate = value?.Date;

    private void Cancel() => MudDialog.Cancel();
}
