@using PanoramicAdmin.Models
@using Microsoft.AspNetCore.Components.Forms
@using PanoramicAdmin.Services
@inject ILogger<ScrumProductBacklogItemDialog> Logger
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_module" Label="Module"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              MaxLength="100" Lines="3" Class="pbi-multiline-field" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_summary" Label="Summary"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              MaxLength="250" Lines="3" Class="pbi-multiline-field" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_acceptanceCriteria" Label="Acceptance Criteria (AC)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              Lines="3" Class="pbi-multiline-field" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_priority" Label="Priority"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var priority in ScrumProductBacklogCatalog.Priorities)
                    {
                        <MudSelectItem T="string" Value="@priority">@priority</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="int?" @bind-Value="_targetSprint" Label="Target Sprint"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Step="1"
                                 Clearable="true" HelperText="1 Sprint = 2 Minggu" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_definitionOfDone" Label="Definition of Done (DoD)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Lines="3" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="pbi-image-upload-title">Gambar pelengkap</MudText>
                <InputFile OnChange="OnImagesSelected" multiple
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           class="pbi-image-input" disabled="@_isReadingImages" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Pilih maksimal 10 gambar JPG, PNG, atau WebP. Ukuran maksimal 5 MB per gambar.
                </MudText>
                @if (_imageSelectionError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_imageSelectionError</MudText>
                }
                @if (_selectedImages.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="pbi-selected-images">
                        @foreach (var image in _selectedImages)
                        {
                            <span>@image.Name</span>
                        }
                    </MudText>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="@_isReadingImages">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   Disabled="@_isReadingImages">Simpan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ScrumProductBacklogItemRow? InitialValue { get; set; }
    [Parameter] public string DialogTitle { get; set; } = "Tambah Product Backlog Item";

    private string _module = string.Empty;
    private string _summary = string.Empty;
    private string _acceptanceCriteria = string.Empty;
    private string _priority = "Sedang";
    private int? _targetSprint;
    private string _definitionOfDone = string.Empty;
    private IReadOnlyList<IBrowserFile> _selectedImages = [];
    private string? _imageSelectionError;
    private bool _isReadingImages;

    protected override void OnInitialized()
    {
        if (InitialValue is not { } item)
        {
            return;
        }

        _module = item.Module;
        _summary = item.Summary;
        _acceptanceCriteria = item.AcceptanceCriteria;
        _priority = item.Priority;
        _targetSprint = item.TargetSprint;
        _definitionOfDone = item.DefinitionOfDone;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_module) ||
            string.IsNullOrWhiteSpace(_summary) ||
            string.IsNullOrWhiteSpace(_acceptanceCriteria) ||
            string.IsNullOrWhiteSpace(_definitionOfDone) ||
            _imageSelectionError is not null)
        {
            return;
        }

        _isReadingImages = true;
        try
        {
            var images = await ScrumProductBacklogImageValidator.ReadAsync(_selectedImages);
            MudDialog.Close(DialogResult.Ok(new ScrumProductBacklogItemInput(
                InitialValue?.Id,
                _module,
                _summary,
                _acceptanceCriteria,
                _priority,
                _targetSprint,
                _definitionOfDone,
                images)));
        }
        catch (InvalidDataException exception)
        {
            _imageSelectionError = exception.Message;
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or JSException)
        {
            Logger.LogWarning(exception, "Failed to read selected Product Backlog Item images.");
            _imageSelectionError = "Gambar tidak dapat dibaca. Pilih ulang gambar dan coba lagi.";
        }
        finally
        {
            _isReadingImages = false;
        }
    }

    private void OnImagesSelected(InputFileChangeEventArgs args)
    {
        try
        {
            _selectedImages = args.GetMultipleFiles(10);
            _imageSelectionError = null;
        }
        catch (InvalidOperationException)
        {
            _selectedImages = [];
            _imageSelectionError = "Pilih maksimal 10 gambar dalam sekali upload.";
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
