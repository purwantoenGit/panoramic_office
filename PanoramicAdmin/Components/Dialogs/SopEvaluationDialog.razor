@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels

<MudDialog Class="sop-evaluation-dialog">
    <TitleContent>
        <div class="add-project-header">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="add-project-title">Evaluasi SOP</MudText>
                <MudText Typo="Typo.caption" Class="add-project-subtitle">
                    @ApplicationName · @Category.Name
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Fokus: @Category.Focus
        </MudAlert>

        <MudPaper Class="sop-document-section" Elevation="0">
            <div class="sop-document-section-heading">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="sop-document-section-title">
                        Dokumen Pendukung
                    </MudText>
                    <MudText Typo="Typo.caption">
                        Tambahkan beberapa SOP, lalu tambahkan INK atau STD sebagai dokumen turunannya.
                        Judul SOP boleh dikosongkan; judul INK/STD tetap wajib diisi.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddSopDocument">
                    Tambah SOP
                </MudButton>
            </div>

            @if (_documents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    Belum ada dokumen. Penilaian tetap dapat disimpan tanpa dokumen.
                </MudAlert>
            }
            else
            {
                @for (var index = 0; index < _documents.Count; index++)
                {
                    var document = _documents[index];
                    <MudPaper @key="document.Id" Class="sop-document-card" Elevation="0">
                        <div class="sop-document-card-heading">
                            <div class="sop-document-card-title">
                                @if (document.IsStandalone)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        INK/STD
                                    </MudChip>
                                    <MudText Typo="Typo.subtitle2">Dokumen mandiri (tanpa SOP)</MudText>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                        SOP
                                    </MudChip>
                                    <MudText Typo="Typo.subtitle2">Dokumen SOP @(index + 1)</MudText>
                                }
                            </div>
                            @if (!document.IsStandalone)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                               Size="Size.Small" aria-label="@($"Hapus SOP {index + 1}")"
                                               OnClick="@(() => RemoveSopDocument(document))" />
                            }
                        </div>
                        @if (!document.IsStandalone)
                        {
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string" @bind-Value="document.Title" Label="Judul SOP"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="250"
                                                  Required="false" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudTextField T="string" @bind-Value="document.DocumentNumber" Label="Nomor"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudTextField T="string" @bind-Value="document.Revision" Label="Revisi"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" @bind-Value="document.EvidenceUrl" Label="Tautan dokumen"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="1000"
                                                  Placeholder="https://..." />
                                </MudItem>
                            </MudGrid>
                        }

                        <div class="sop-child-document-heading">
                            <MudText Typo="Typo.body2">@(document.IsStandalone ? "Dokumen" : "Dokumen turunan")</MudText>
                            <div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => AddChildDocument(document, "INK"))">
                                    Tambah INK
                                </MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => AddChildDocument(document, "STD"))">
                                    Tambah STD
                                </MudButton>
                            </div>
                        </div>

                        @if (document.Children.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Belum ada INK atau STD untuk SOP ini.
                            </MudText>
                        }
                        @foreach (var child in document.Children)
                        {
                            <div @key="child.Id" class="sop-child-document-card">
                                <div class="sop-document-card-heading">
                                    <div class="sop-document-card-title">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                            @child.DocumentType
                                        </MudChip>
                                        <MudText Typo="Typo.caption">Dokumen turunan</MudText>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                                   Size="Size.Small"
                                                   aria-label="@($"Hapus {child.DocumentType}: {child.Title}")"
                                                   OnClick="@(() => RemoveChildDocument(document, child))" />
                                </div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" @bind-Value="child.Title" Label="Judul"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="250"
                                                      Required="true" RequiredError="Judul dokumen wajib diisi." />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField T="string" @bind-Value="child.DocumentNumber" Label="Nomor"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField T="string" @bind-Value="child.Revision" Label="Revisi"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" @bind-Value="child.EvidenceUrl" Label="Tautan dokumen"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="1000"
                                                      Placeholder="https://..." />
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                    </MudPaper>
                }
            }
        </MudPaper>

        <MudPaper Class="sop-assessment-section" Elevation="0">
            <MudText Typo="Typo.subtitle1" Class="sop-document-section-title">
                Penilaian Keseluruhan
            </MudText>
            <MudText Typo="Typo.caption" Class="d-block mb-3">
                Satu level penilaian berlaku untuk seluruh SOP, INK, dan STD pada area evaluasi ini.
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSelect T="int" Value="@_level" ValueChanged="OnLevelChanged"
                               Label="Level Evaluasi" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Required="true" RequiredError="Pilih level evaluasi.">
                        @for (var level = 0; level <= 4; level++)
                        {
                            var levelValue = level;
                            <MudSelectItem T="int" Value="@levelValue">
                                @levelValue · @SopEvaluationCatalog.GetLevelName(levelValue)
                            </MudSelectItem>
                        }
                    </MudSelect>
                    @if (_level >= 0)
                    {
                        <MudText Typo="Typo.caption" Class="sop-dialog-level-description">
                            @SopEvaluationCatalog.GetLevelDescription(_level)
                        </MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_ownerName" Label="PIC / Owner Evaluasi"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="150" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_evaluationDate" Label="Tanggal Evaluasi"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_findings" Label="Temuan / Catatan Evaluasi"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                                  Placeholder="Catat bukti implementasi, hasil pemeriksaan, atau gap yang ditemukan." />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_followUpAction" Label="Tindak Lanjut"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_followUpDueDate" Label="Target Tindak Lanjut"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_validationMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                @_validationMessage
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <div class="add-project-actions">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Batal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                       StartIcon="@Icons.Material.Filled.Check" Class="add-project-save">
                Simpan Evaluasi
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string ApplicationName { get; set; } = string.Empty;
    [Parameter] public SopEvaluationCategory Category { get; set; } = default!;
    [Parameter] public SopEvaluation? InitialValue { get; set; }

    private readonly List<SopDocumentDraft> _documents = [];
    private int _level = -1;
    private string? _ownerName;
    private DateTime? _evaluationDate;
    private string? _findings;
    private string? _followUpAction;
    private DateTime? _followUpDueDate;
    private string? _validationMessage;

    protected override void OnInitialized()
    {
        if (InitialValue is not { } value)
        {
            return;
        }

        _level = value.Level ?? -1;
        _ownerName = value.OwnerName;
        _evaluationDate = value.EvaluationDate;
        _findings = value.Findings;
        _followUpAction = value.FollowUpAction;
        _followUpDueDate = value.FollowUpDueDate;
        _documents.AddRange(value.Documents.Select(document => new SopDocumentDraft
        {
            Title = document.Title,
            DocumentNumber = document.DocumentNumber,
            Revision = document.Revision,
            EvidenceUrl = document.EvidenceUrl,
            IsStandalone = string.IsNullOrWhiteSpace(document.Title) && document.Children.Count > 0,
            Children = document.Children.Select(child => new ChildDocumentDraft
            {
                DocumentType = child.DocumentType,
                Title = child.Title,
                DocumentNumber = child.DocumentNumber,
                Revision = child.Revision,
                EvidenceUrl = child.EvidenceUrl
            }).ToList()
        }));
    }

    private void AddSopDocument() => _documents.Add(new SopDocumentDraft());

    private static void AddChildDocument(SopDocumentDraft document, string type) =>
        document.Children.Add(new ChildDocumentDraft { DocumentType = type });

    private void RemoveSopDocument(SopDocumentDraft document)
    {
        if (document.Children.Count == 0)
        {
            _documents.Remove(document);
            return;
        }

        document.Title = string.Empty;
        document.DocumentNumber = null;
        document.Revision = null;
        document.EvidenceUrl = null;
        document.IsStandalone = true;
    }

    private void RemoveChildDocument(SopDocumentDraft document, ChildDocumentDraft child)
    {
        document.Children.Remove(child);
        if (document.IsStandalone && document.Children.Count == 0)
        {
            _documents.Remove(document);
        }
    }

    private void OnLevelChanged(int level)
    {
        _level = level;
        _validationMessage = null;
    }

    private void Save()
    {
        if (_level is < 0 or > 4)
        {
            _validationMessage = "Pilih level evaluasi SOP.";
            return;
        }

        if (_documents.Any(document =>
                document.Children.Any(child => string.IsNullOrWhiteSpace(child.Title))))
        {
            _validationMessage = "Isi judul setiap dokumen turunan atau hapus dokumen turunan yang kosong.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new SopEvaluationInput(
            ApplicationName,
            Category.Name,
            _level,
            _documents.Select(document => new SopEvaluationDocumentInput(
                document.Title,
                document.DocumentNumber,
                document.Revision,
                document.EvidenceUrl,
                document.Children.Select(child => new SopEvaluationChildDocumentInput(
                    child.DocumentType,
                    child.Title,
                    child.DocumentNumber,
                    child.Revision,
                    child.EvidenceUrl)).ToList())).ToList(),
            _ownerName,
            _evaluationDate,
            _findings,
            _followUpAction,
            _followUpDueDate)));
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class SopDocumentDraft
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Title { get; set; } = string.Empty;
        public string? DocumentNumber { get; set; }
        public string? Revision { get; set; }
        public string? EvidenceUrl { get; set; }
        public bool IsStandalone { get; set; }
        public List<ChildDocumentDraft> Children { get; set; } = [];
    }

    private sealed class ChildDocumentDraft
    {
        public Guid Id { get; } = Guid.NewGuid();
        public required string DocumentType { get; init; }
        public string Title { get; set; } = string.Empty;
        public string? DocumentNumber { get; set; }
        public string? Revision { get; set; }
        public string? EvidenceUrl { get; set; }
    }
}
