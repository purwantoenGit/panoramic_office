@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels

<MudDialog Class="sop-evaluation-dialog">
    <TitleContent>
        <div class="add-project-header">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="add-project-title">Evaluasi SOP</MudText>
                <MudText Typo="Typo.caption" Class="add-project-subtitle">
                    @ApplicationName · @Category.Name
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Fokus: @Category.Focus
        </MudAlert>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="int" Value="@_level" ValueChanged="OnLevelChanged"
                           Label="Level Evaluasi" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Required="true" RequiredError="Pilih level evaluasi.">
                    @for (var level = 0; level <= 4; level++)
                    {
                        var levelValue = level;
                        <MudSelectItem T="int" Value="@levelValue">
                            @levelValue · @SopEvaluationCatalog.GetLevelName(levelValue)
                        </MudSelectItem>
                    }
                </MudSelect>
                @if (_level >= 0)
                {
                    <MudText Typo="Typo.caption" Class="sop-dialog-level-description">
                        @SopEvaluationCatalog.GetLevelDescription(_level)
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" @bind-Value="_documentTitle" Label="Judul SOP"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="250"
                              Placeholder="Contoh: Prosedur Operasional Aplikasi OPA" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_documentNumber" Label="Nomor Dokumen"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_revision" Label="Revisi"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_ownerName" Label="PIC / Owner"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="150" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="_evaluationDate" Label="Tanggal Evaluasi"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" Clearable="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_evidenceUrl" Label="Tautan Bukti / Dokumen"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="1000"
                              Placeholder="https://..." />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_findings" Label="Temuan / Catatan Evaluasi"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                              Placeholder="Catat bukti implementasi, hasil pemeriksaan, atau gap yang ditemukan." />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_followUpAction" Label="Tindak Lanjut"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_followUpDueDate" Label="Target Tindak Lanjut"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" Clearable="true" />
            </MudItem>
        </MudGrid>
        @if (_validationMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                @_validationMessage
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <div class="add-project-actions">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Batal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                       StartIcon="@Icons.Material.Filled.Check" Class="add-project-save">
                Simpan Evaluasi
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string ApplicationName { get; set; } = string.Empty;
    [Parameter] public SopEvaluationCategory Category { get; set; } = default!;
    [Parameter] public SopEvaluation? InitialValue { get; set; }

    private int _level = -1;
    private string? _documentTitle;
    private string? _documentNumber;
    private string? _revision;
    private string? _ownerName;
    private string? _evidenceUrl;
    private DateTime? _evaluationDate;
    private string? _findings;
    private string? _followUpAction;
    private DateTime? _followUpDueDate;
    private string? _validationMessage;

    protected override void OnInitialized()
    {
        if (InitialValue is not { } value)
        {
            return;
        }

        _level = value.Level ?? -1;
        _documentTitle = value.DocumentTitle;
        _documentNumber = value.DocumentNumber;
        _revision = value.Revision;
        _ownerName = value.OwnerName;
        _evidenceUrl = value.EvidenceUrl;
        _evaluationDate = value.EvaluationDate;
        _findings = value.Findings;
        _followUpAction = value.FollowUpAction;
        _followUpDueDate = value.FollowUpDueDate;
    }

    private void OnLevelChanged(int level)
    {
        _level = level;
        _validationMessage = null;
    }

    private void Save()
    {
        if (_level is < 0 or > 4)
        {
            _validationMessage = "Pilih level evaluasi SOP.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new SopEvaluationInput(
            ApplicationName,
            Category.Name,
            _level,
            _documentTitle,
            _documentNumber,
            _revision,
            _ownerName,
            _evidenceUrl,
            _evaluationDate,
            _findings,
            _followUpAction,
            _followUpDueDate)));
    }

    private void Cancel() => MudDialog.Cancel();
}
