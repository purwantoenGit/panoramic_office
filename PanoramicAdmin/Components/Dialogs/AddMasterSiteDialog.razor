<MudDialog Class="add-project-dialog">
    <TitleContent>
        <div class="add-project-header">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.Place" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="add-project-title">Tambah Site</MudText>
                <MudText Typo="Typo.caption" Class="add-project-subtitle">
                    Masukkan nama site dan statusnya.
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_sites" Label="Sites"
                      Placeholder="Contoh: Jakarta"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                      MaxLength="150" Counter="150"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Place" />
        <MudSelect T="string" @bind-Value="_status" Label="Status"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
            <MudSelectItem Value="@("Active")">Active</MudSelectItem>
            <MudSelectItem Value="@("Non Active")">Non Active</MudSelectItem>
        </MudSelect>
        @if (_validationMessage is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Error">@_validationMessage</MudText>
        }
    </DialogContent>
    <DialogActions>
        <div class="add-project-actions">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Batal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                       StartIcon="@Icons.Material.Filled.Check" Class="add-project-save">
                Simpan Site
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _sites = string.Empty;
    private string _status = "Active";
    private string? _validationMessage;

    private void Save()
    {
        var sites = _sites.Trim();
        if (string.IsNullOrWhiteSpace(sites))
        {
            _validationMessage = "Sites wajib diisi.";
            return;
        }

        if (sites.Length > 150)
        {
            _validationMessage = "Sites maksimal 150 karakter.";
            return;
        }

        if (_status is not ("Active" or "Non Active"))
        {
            _validationMessage = "Pilih status yang tersedia.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new MasterSiteInput(sites, _status)));
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed record MasterSiteInput(string Sites, string Status);
}
