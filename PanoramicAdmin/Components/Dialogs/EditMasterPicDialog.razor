@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels

<MudDialog Class="add-project-dialog master-pic-edit-dialog">
    <TitleContent>
        <div class="add-project-header">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Class="add-project-title">Edit Master PIC</MudText>
                <MudText Typo="Typo.caption" Class="add-project-subtitle">
                    Perbarui identitas, role, email, dan kontak WhatsApp PIC.
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="master-pic-edit-fields">
            <MudTextField T="string" @bind-Value="_nama" Label="Nama"
                          Placeholder="Masukkan nama PIC"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                          MaxLength="150" Counter="150"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
            <MudSelect T="string" @bind-Value="_role" Label="Role"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Required="true" RequiredError="Pilih role dari Master Roles."
                       Disabled="@(Roles.Count == 0)"
                       Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Work">
                @foreach (var role in Roles)
                {
                    <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_phoneNumber" Label="Nomor WhatsApp"
                          Placeholder="+6281234567890"
                          HelperText="Nomor internasional; awali dengan kode negara."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Call" />
            <MudTextField T="string" @bind-Value="_whatsAppId" Label="WA ID (opsional)"
                          Placeholder="6281234567890@lid"
                          HelperText="Fallback jika nomor tidak dapat dipetakan."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AlternateEmail" />
            <MudTextField T="string" @bind-Value="_email" Label="Email (opsional)"
                          Placeholder="nama@perusahaan.com"
                          HelperText="Dipakai untuk mengirim Action Plan melalui email."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
        </div>
        @if (_validationMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined"
                      Class="master-pic-edit-alert">
                @_validationMessage
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <div class="add-project-actions">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Batal</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                       StartIcon="@Icons.Material.Filled.Check" Class="add-project-save">
                Simpan Perubahan
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public MasterPicRow Pic { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<string> Roles { get; set; } = [];

    private string _nama = string.Empty;
    private string _role = string.Empty;
    private string _phoneNumber = string.Empty;
    private string _whatsAppId = string.Empty;
    private string _email = string.Empty;
    private string? _validationMessage;

    protected override void OnParametersSet()
    {
        _nama = Pic.Nama;
        _role = Roles.Contains(Pic.Role, StringComparer.Ordinal)
            ? Pic.Role
            : Roles.FirstOrDefault() ?? string.Empty;
        _phoneNumber = Pic.PhoneNumber ?? string.Empty;
        _whatsAppId = Pic.WhatsAppId ?? string.Empty;
        _email = Pic.Email ?? string.Empty;
    }

    private void Save()
    {
        var nama = _nama.Trim();
        var role = _role.Trim();
        if (string.IsNullOrWhiteSpace(nama))
        {
            _validationMessage = "Nama wajib diisi.";
            return;
        }

        if (nama.Length > 150)
        {
            _validationMessage = "Nama maksimal 150 karakter.";
            return;
        }

        if (!Roles.Contains(role, StringComparer.Ordinal))
        {
            _validationMessage = "Pilih role yang tersedia dari Master Roles.";
            return;
        }

        if (!MasterPicContact.TryNormalizePhoneNumber(_phoneNumber, out var phoneNumber))
        {
            _validationMessage = "Nomor WhatsApp harus berupa nomor internasional, contoh +6281234567890.";
            return;
        }

        if (!MasterPicContact.TryNormalizeWhatsAppId(_whatsAppId, out var whatsAppId))
        {
            _validationMessage = "WA ID harus berbentuk nomor@c.us, nomor@s.whatsapp.net, atau nomor@lid.";
            return;
        }

        if (!MasterPicContact.TryNormalizeEmail(_email, out var email))
        {
            _validationMessage = "Alamat email PIC tidak valid.";
            return;
        }

        MudDialog.Close(DialogResult.Ok(new MasterPicInput(nama, role, phoneNumber, whatsAppId, email)));
    }

    private void Cancel() => MudDialog.Cancel();
}
