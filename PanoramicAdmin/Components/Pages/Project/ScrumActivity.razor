@page "/scrum-activity"

<PageTitle>Scrum Activity | Panoramic Office</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Scrum Activity</MudText>
        <MudText Typo="Typo.body2" Class="page-subtitle">
            Pantau aktivitas scrum dan progres tim project.
        </MudText>
    </div>
</div>

<MudPaper Class="section-card empty-state" Elevation="0">
    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
        <MudIcon Icon="@Icons.Material.Filled.Groups" />
    </MudAvatar>
    <MudText Typo="Typo.h6" Class="section-title">Belum ada aktivitas scrum</MudText>
    <MudText Typo="Typo.body2" Class="page-subtitle">
        Aktivitas scrum akan ditampilkan di sini.
    </MudText>
</MudPaper>
