@page "/agenda"

<PageTitle>Daily Agenda | Panoramic Office</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Daily Agenda</MudText>
        <MudText Typo="Typo.body2" Class="page-subtitle">Agenda harian workspace Anda.</MudText>
    </div>
</div>

<MudPaper Class="section-card empty-state" Elevation="0">
    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
        <MudIcon Icon="@Icons.Material.Filled.EventNote" />
    </MudAvatar>
    <MudText Typo="Typo.h6" Class="section-title">Belum ada agenda</MudText>
    <MudText Typo="Typo.body2" Class="page-subtitle">
        Agenda harian akan ditampilkan di sini.
    </MudText>
</MudPaper>
