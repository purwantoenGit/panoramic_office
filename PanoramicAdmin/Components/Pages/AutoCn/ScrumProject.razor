@page "/scrum-project"
@implements IDisposable
@using PanoramicAdmin.Components.Dialogs
@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels
@inject IDialogService DialogService
@inject ScrumProjectViewModel ViewModel

<PageTitle>Scrum Monitoring | Panoramic Office</PageTitle>

<MudTabs Elevation="0" Color="Color.Primary" Rounded="true" Border="true"
         Class="smart-refueling-tabs scrum-monitoring-tabs"
         @bind-ActivePanelIndex="_activePanelIndex">
<MudTabPanel Text="Sprint Monitoring">
<div class="page-heading scrum-page-heading">
    <div class="scrum-page-title">
        <MudText Typo="Typo.overline" Class="scrum-eyebrow">DIGITAL INITIATIVE / AUTO CN</MudText>
        <MudText Typo="Typo.h4" Class="page-title">Scrum Monitoring</MudText>
        <MudText Typo="Typo.body2" Class="page-subtitle">
            Pantau progres sprint, pekerjaan tim, dan tindak lanjut hambatan.
        </MudText>
    </div>
    <div class="d-flex align-center flex-wrap gap-2 scrum-page-actions">
        @if (ViewModel.Sprints.Count > 0)
        {
            <MudSelect T="int?" Value="@ViewModel.SelectedSprintId" ValueChanged="OnSprintChanged"
                       Label="Pilih sprint" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Class="scrum-sprint-selector" Disabled="@ViewModel.IsLoading">
                @foreach (var sprint in ViewModel.Sprints)
                {
                    <MudSelectItem T="int?" Value="@((int?)sprint.Id)">
                        @(sprint.ProductBacklogItemCode ?? sprint.Name) · @sprint.Status
                    </MudSelectItem>
                }
            </MudSelect>
        }
        @if (ViewModel.SelectedSprint is not null)
        {
            <MudAutocomplete T="ScrumPicFilterOption" Value="@ViewModel.SelectedPicFilter"
                             ValueChanged="ViewModel.FilterTasksByPic"
                             SearchFunc="SearchPicFilterOptionsAsync"
                             ToStringFunc="PicFilterOptionToString"
                             Label="Filter PIC" Placeholder="Ketik nama PIC..."
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             MinCharacters="0" MaxItems="20" Clearable="true" Immediate="true"
                             ResetValueOnEmptyText="true" Class="scrum-pic-filter"
                             Disabled="@ViewModel.IsLoading" />
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenSprintDialogAsync(null))"
                   Disabled="@ViewModel.IsSaving">
            Sprint
        </MudButton>
        @if (ViewModel.SelectedSprint is { } selectedSprint)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                           aria-label="Edit sprint" OnClick="@(() => OpenSprintDialogAsync(selectedSprint))"
                           Disabled="@ViewModel.IsSaving" />
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                           aria-label="Hapus sprint" OnClick="@(() => RequestDelete($"sprint-{selectedSprint.Id}"))"
                           Disabled="@ViewModel.IsSaving" />
        }
    </div>
</div>

@if (ViewModel.SprintDeleteMessage is { } sprintDeleteMessage)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        @sprintDeleteMessage
    </MudAlert>
}

@if (ViewModel.SelectedSprint is { } sprintToDelete &&
     _pendingDeleteKey == $"sprint-{sprintToDelete.Id}")
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        Hapus sprint ini? Penghapusan hanya bisa dilakukan jika sprint tidak memiliki task atau blocker.
        <MudButton Color="Color.Error" OnClick="@(() => ConfirmDeleteAsync("sprint", sprintToDelete.Id))"
                   Disabled="@ViewModel.IsSaving">
            Hapus sprint
        </MudButton>
        <MudButton OnClick="CancelDelete" Disabled="@ViewModel.IsSaving">Batal</MudButton>
    </MudAlert>
}

@if (ViewModel.IsLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    <MudText Class="pa-6" Align="Align.Center" Color="Color.Secondary">Memuat Scrum Monitoring...</MudText>
}
else if (ViewModel.DatabaseError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
            <span>@ViewModel.DatabaseError</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       OnClick="@(() => ViewModel.LoadAsync(ViewModel.SelectedSprintId, ProductBacklogItemId))"
                       Disabled="@ViewModel.IsSaving">
                Coba lagi
            </MudButton>
        </div>
    </MudAlert>
}
else if (ViewModel.SelectedSprint is not { } sprint)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @if (ProductBacklogItemId is { } productBacklogItemId)
        {
            if (ViewModel.ProductBacklogItems.Any(item => item.Id == productBacklogItemId))
            {
                <span>PBI-SMARE-@productBacklogItemId.ToString("000") belum memiliki sprint. Gunakan tombol Sprint untuk membuatnya.</span>
            }
            else
            {
                <span>Product Backlog Item tidak ditemukan. Periksa kembali daftar PBI.</span>
            }
        }
        else
        {
            <span>Belum ada sprint. Tambahkan sprint untuk mulai mengelola task dan blocker.</span>
        }
    </MudAlert>
}
else
{
    <MudPaper Class="scrum-sprint-overview mb-4" Elevation="0">
        <div class="scrum-sprint-banner">
            <div>
                <div class="scrum-sprint-name">
                    <MudText Typo="Typo.overline">@sprint.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@GetSprintStatusColor(sprint.Status)"
                             Variant="Variant.Filled">
                        @sprint.Status
                    </MudChip>
                </div>
                @if (sprint.ProductBacklogItemSummary is { } productBacklogItemSummary)
                {
                    <MudText Typo="Typo.subtitle1">@productBacklogItemSummary</MudText>
                }
                <MudText Typo="Typo.h5" Class="scrum-sprint-focus">@sprint.Focus</MudText>
                <div class="scrum-sprint-meta">
                    <span>
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                        @sprint.StartDate.ToString("dd MMM yyyy") – @sprint.EndDate.ToString("dd MMM yyyy")
                    </span>
                    <span>
                        <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" />
                        Sprint @sprint.Status.ToLowerInvariant()
                    </span>
                </div>
            </div>
            <div class="scrum-sprint-days">
                <MudText Typo="Typo.h4">@ViewModel.DaysRemaining</MudText>
                <MudText Typo="Typo.caption">hari tersisa</MudText>
            </div>
        </div>

        <div class="scrum-sprint-progress">
            <div class="scrum-progress-label">
                <MudText Typo="Typo.body2">Progres penyelesaian sprint</MudText>
                <MudText Typo="Typo.body2">
                    <strong>@ViewModel.CompletedTaskCount dari @ViewModel.Tasks.Count task</strong>
                    <span> · @ViewModel.CompletionPercent.ToString("0")%</span>
                </MudText>
            </div>
            <MudProgressLinear Value="@ViewModel.CompletionPercent" Color="Color.Primary"
                               Rounded="true" Size="Size.Medium" />
        </div>
    </MudPaper>

    <div class="scrum-metrics">
        <MudPaper Class="scrum-metric" Elevation="0">
            <div class="scrum-metric-icon scrum-icon-blue">
                <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Class="scrum-metric-label">Total task</MudText>
                <div class="scrum-metric-value-row">
                    <MudText Typo="Typo.h5" Class="scrum-metric-value">@ViewModel.Tasks.Count</MudText>
                    <MudText Typo="Typo.caption" Class="scrum-metric-note">di sprint ini</MudText>
                </div>
            </div>
        </MudPaper>
        <MudPaper Class="scrum-metric" Elevation="0">
            <div class="scrum-metric-icon scrum-icon-green">
                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Class="scrum-metric-label">Selesai</MudText>
                <div class="scrum-metric-value-row">
                    <MudText Typo="Typo.h5" Class="scrum-metric-value">@ViewModel.CompletedTaskCount</MudText>
                    <MudText Typo="Typo.caption" Class="scrum-metric-note">@ViewModel.CompletionPercent.ToString("0")% dari total</MudText>
                </div>
            </div>
        </MudPaper>
        <MudPaper Class="scrum-metric" Elevation="0">
            <div class="scrum-metric-icon scrum-icon-violet">
                <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Class="scrum-metric-label">Berjalan</MudText>
                <div class="scrum-metric-value-row">
                    <MudText Typo="Typo.h5" Class="scrum-metric-value">@ViewModel.InProgressTaskCount</MudText>
                    <MudText Typo="Typo.caption" Class="scrum-metric-note">sedang dikerjakan</MudText>
                </div>
            </div>
        </MudPaper>
        <MudPaper Class="scrum-metric" Elevation="0">
            <div class="scrum-metric-icon scrum-icon-red">
                <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
            </div>
            <div>
                <MudText Typo="Typo.caption" Class="scrum-metric-label">Blocker</MudText>
                <div class="scrum-metric-value-row">
                    <MudText Typo="Typo.h5" Class="scrum-metric-value">@ViewModel.ActiveBlockerCount</MudText>
                    <MudText Typo="Typo.caption" Class="scrum-metric-note">perlu perhatian</MudText>
                </div>
            </div>
        </MudPaper>
    </div>

    <div class="scrum-board-heading">
        <div>
            <MudText Typo="Typo.h6" Class="section-title">Papan sprint</MudText>
            <MudText Typo="Typo.body2" Class="section-subtitle">
                Distribusi task berdasarkan status pengerjaan.
            </MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Class="scrum-board-total">@ViewModel.FilteredTasks.Count task</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenTaskDialogAsync(null))"
                       Disabled="@ViewModel.IsSaving">
                Tambah task
            </MudButton>
        </div>
    </div>

    <div class="scrum-board-scroll">
        <div class="scrum-board">
            @foreach (var status in ScrumProjectViewModel.TaskStatuses)
            {
                var columnTasks = ViewModel.FilteredTasks.Where(task => task.Status == status).ToArray();
                <MudPaper Class="@($"scrum-column {GetColumnClass(status)}")" Elevation="0">
                    <div class="scrum-column-heading">
                        <div class="scrum-column-title">
                            <span class="scrum-status-dot"></span>
                            <MudText Typo="Typo.subtitle2">@status</MudText>
                        </div>
                        <span class="scrum-column-count">@columnTasks.Length</span>
                    </div>
                    <div class="scrum-column-tasks">
                        @foreach (var task in columnTasks)
                        {
                            <div class="@($"scrum-task-card {GetTaskCardClass(task.Status)}")">
                                <div class="scrum-task-meta">
                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.caption" Class="scrum-task-id">@task.Code</MudText>
                                        <span class="scrum-task-category">
                                            @(task.Category ?? "Belum dikategorikan")
                                        </span>
                                    </div>
                                    <div class="d-flex align-center gap-1">
                                        <span class="@($"scrum-priority {GetPriorityClass(task.Priority)}")">@task.Priority</span>
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       aria-label="Edit task" OnClick="@(() => OpenTaskDialogAsync(task))"
                                                       Disabled="@ViewModel.IsSaving" />
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                                       Size="Size.Small" aria-label="Hapus task"
                                                       OnClick="@(() => RequestDelete($"task-{task.Id}"))"
                                                       Disabled="@ViewModel.IsSaving" />
                                    </div>
                                </div>
                                <MudText Typo="Typo.body2" Class="scrum-task-title">@task.Title</MudText>
                                @if (!string.IsNullOrWhiteSpace(task.Notes))
                                {
                                    <MudText Typo="Typo.caption" Class="scrum-task-notes">@task.Notes</MudText>
                                }
                                <div class="scrum-task-footer">
                                    <div class="scrum-task-owner">
                                        <MudAvatar Size="Size.Small" Color="Color.Primary"
                                                   Class="scrum-owner-avatar">@task.Initials</MudAvatar>
                                        <MudText Typo="Typo.caption">
                                            @(string.IsNullOrWhiteSpace(task.Owner) ? "Belum ditentukan" : task.Owner)
                                        </MudText>
                                    </div>
                                    <span class="scrum-task-estimate">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />
                                        @(task.EstimatedHour is { } estimatedHour
                                            ? $"{estimatedHour:0.##} jam"
                                            : "Belum diestimasi")
                                    </span>
                                </div>
                                @if (_pendingDeleteKey == $"task-{task.Id}")
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                        Hapus task ini?
                                        <MudButton Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => ConfirmDeleteAsync("task", task.Id))">
                                            Hapus
                                        </MudButton>
                                        <MudButton Size="Size.Small" OnClick="CancelDelete">Batal</MudButton>
                                    </MudAlert>
                                }
                            </div>
                        }
                        @if (columnTasks.Length == 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">
                                Belum ada task.
                            </MudText>
                        }
                    </div>
                </MudPaper>
            }
        </div>
    </div>

    <MudPaper Class="scrum-blockers" Elevation="0">
        <div class="scrum-blockers-heading">
            <div>
                <div class="scrum-blockers-title">
                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Error" />
                    <MudText Typo="Typo.h6" Class="section-title">Perlu tindak lanjut</MudText>
                    <span class="scrum-blocker-count">@ViewModel.ActiveBlockerCount</span>
                </div>
                <MudText Typo="Typo.body2" Class="section-subtitle">
                    Hambatan aktif yang berpotensi memengaruhi target sprint.
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenBlockerDialogAsync(null))"
                       Disabled="@ViewModel.IsSaving">
                Tambah blocker
            </MudButton>
        </div>
        @if (ViewModel.Blockers.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Belum ada blocker untuk sprint ini.</MudText>
        }
        else
        {
            <div class="scrum-blocker-list">
                @foreach (var blocker in ViewModel.Blockers)
                {
                    <div class="scrum-blocker-item">
                        <div class="scrum-blocker-indicator">
                            <MudIcon Icon="@(blocker.IsResolved
                                                ? Icons.Material.Filled.CheckCircleOutline
                                                : Icons.Material.Filled.ErrorOutline)"
                                     Size="Size.Small" />
                        </div>
                        <div class="scrum-blocker-copy">
                            <div class="d-flex align-center flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle2" Class="scrum-blocker-name">@blocker.Title</MudText>
                                @if (blocker.IsResolved)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Selesai</MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.body2" Class="scrum-blocker-detail">@blocker.Detail</MudText>
                            <MudText Typo="Typo.caption" Class="scrum-blocker-next">
                                Tindak lanjut: @blocker.NextStep
                            </MudText>
                        </div>
                        <div class="scrum-blocker-owner">
                            <div class="d-flex align-center justify-space-between gap-1">
                                <div>
                                    <MudText Typo="Typo.caption" Class="scrum-metric-label">PIC</MudText>
                                    <MudText Typo="Typo.body2">
                                        @(string.IsNullOrWhiteSpace(blocker.Owner) ? "Belum ditentukan" : blocker.Owner)
                                    </MudText>
                                </div>
                                <div class="d-flex">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   aria-label="Edit blocker" OnClick="@(() => OpenBlockerDialogAsync(blocker))"
                                                   Disabled="@ViewModel.IsSaving" />
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error"
                                                   Size="Size.Small" aria-label="Hapus blocker"
                                                   OnClick="@(() => RequestDelete($"blocker-{blocker.Id}"))"
                                                   Disabled="@ViewModel.IsSaving" />
                                </div>
                            </div>
                        </div>
                        @if (_pendingDeleteKey == $"blocker-{blocker.Id}")
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                Hapus blocker ini?
                                <MudButton Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => ConfirmDeleteAsync("blocker", blocker.Id))">
                                    Hapus
                                </MudButton>
                                <MudButton Size="Size.Small" OnClick="CancelDelete">Batal</MudButton>
                            </MudAlert>
                        }
                    </div>
                }
            </div>
        }
    </MudPaper>

}
    </MudTabPanel>
    <MudTabPanel Text="Product Backlog Item">
        <ProductBacklogItemContent NavigateToSprint="NavigateToSprintAsync" />
    </MudTabPanel>
    </MudTabs>

    @code {
    private string? _pendingDeleteKey;
    private int? _loadedProductBacklogItemId;
    private bool _hasLoadedProductBacklogItem;
    private int _activePanelIndex;

    [SupplyParameterFromQuery(Name = "productBacklogItemId")]
    public int? ProductBacklogItemId { get; set; }

    protected override void OnInitialized()
    {
        ViewModel.StateChanged += OnViewModelStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoadedProductBacklogItem && _loadedProductBacklogItemId == ProductBacklogItemId)
        {
            return;
        }

        _activePanelIndex = 0;
        _hasLoadedProductBacklogItem = true;
        _loadedProductBacklogItemId = ProductBacklogItemId;
        await ViewModel.LoadAsync(productBacklogItemId: ProductBacklogItemId);
    }

    private async Task NavigateToSprintAsync(int productBacklogItemId)
    {
        _activePanelIndex = 0;
        if (ProductBacklogItemId == productBacklogItemId)
        {
            await ViewModel.LoadAsync(productBacklogItemId: productBacklogItemId);
        }
    }

    private Task OnSprintChanged(int? sprintId) =>
        sprintId is { } id ? ViewModel.SelectSprintAsync(id) : Task.CompletedTask;

    private Task<IEnumerable<ScrumPicFilterOption>> SearchPicFilterOptionsAsync(
        string value,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        IEnumerable<ScrumPicFilterOption> options = ViewModel.PicFilterOptions;
        if (!string.IsNullOrWhiteSpace(value))
        {
            options = options.Where(option =>
                option.Label.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(options);
    }

    private static string PicFilterOptionToString(ScrumPicFilterOption? option) =>
        option?.Label ?? string.Empty;

    private async Task OpenSprintDialogAsync(ScrumSprintRow? sprint)
    {
        var parameters = new DialogParameters
        {
            ["InitialValue"] = sprint,
            ["ProductBacklogItems"] = ViewModel.ProductBacklogItems,
            ["DefaultProductBacklogItemId"] = sprint is null ? ProductBacklogItemId : null,
            ["DialogTitle"] = sprint is null ? "Tambah Sprint" : "Edit Sprint"
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };
        var dialog = await DialogService.ShowAsync<ScrumSprintDialog>(
            sprint is null ? "Tambah Sprint" : "Edit Sprint", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ScrumSprintInput input })
        {
            await ViewModel.SaveSprintAsync(input);
        }
    }

    private async Task OpenTaskDialogAsync(ScrumTaskRow? task)
    {
        if (ViewModel.SelectedSprintId is not { } sprintId)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["InitialValue"] = task,
            ["SprintId"] = sprintId,
            ["PicOptions"] = ViewModel.PicOptions,
            ["DialogTitle"] = task is null ? "Tambah Task" : "Edit Task"
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };
        var dialog = await DialogService.ShowAsync<ScrumTaskDialog>(
            task is null ? "Tambah Task" : "Edit Task", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ScrumTaskInput input })
        {
            await ViewModel.SaveTaskAsync(input);
        }
    }

    private async Task OpenBlockerDialogAsync(ScrumBlockerRow? blocker)
    {
        if (ViewModel.SelectedSprintId is not { } sprintId)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["InitialValue"] = blocker,
            ["SprintId"] = sprintId,
            ["DialogTitle"] = blocker is null ? "Tambah Blocker" : "Edit Blocker"
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };
        var dialog = await DialogService.ShowAsync<ScrumBlockerDialog>(
            blocker is null ? "Tambah Blocker" : "Edit Blocker", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ScrumBlockerInput input })
        {
            await ViewModel.SaveBlockerAsync(input);
        }
    }

    private void RequestDelete(string key) => _pendingDeleteKey = key;
    private void CancelDelete() => _pendingDeleteKey = null;

    private async Task ConfirmDeleteAsync(string type, int id)
    {
        _pendingDeleteKey = null;
        switch (type)
        {
            case "sprint":
                await ViewModel.DeleteSprintAsync(id);
                break;
            case "task":
                await ViewModel.DeleteTaskAsync(id);
                break;
            case "blocker":
                await ViewModel.DeleteBlockerAsync(id);
                break;
        }
    }

    private static Color GetSprintStatusColor(string status) => status switch
    {
        "Berjalan" => Color.Success,
        "Selesai" => Color.Default,
        _ => Color.Info
    };

    private static string GetColumnClass(string status) => status switch
    {
        "Sedang dikerjakan" => "scrum-column-progress",
        "Dalam review" => "scrum-column-review",
        "Selesai" => "scrum-column-done",
        _ => "scrum-column-todo"
    };

    private static string GetTaskCardClass(string status) => status switch
    {
        "Belum dimulai" => "scrum-task-todo",
        "Sedang dikerjakan" => "scrum-task-progress",
        "Dalam review" => "scrum-task-review",
        "Selesai" => "scrum-task-done",
        _ => string.Empty
    };

    private static string GetPriorityClass(string priority) => priority switch
    {
        "Tinggi" => "priority-high",
        "Rendah" => "priority-low",
        _ => "priority-medium"
    };

    private void OnViewModelStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ViewModel.StateChanged -= OnViewModelStateChanged;
}
