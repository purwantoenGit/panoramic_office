@page "/master-pic"
@implements IDisposable
@using PanoramicAdmin.Components.Dialogs
@using PanoramicAdmin.Models
@using PanoramicAdmin.ViewModels
@inject IDialogService DialogService
@inject MasterPicViewModel ViewModel

<PageTitle>Master PIC | Panoramic Office</PageTitle>

<div class="page-heading">
    <div>
        <MudText Typo="Typo.h4" Class="page-title">Master PIC</MudText>
        <MudText Typo="Typo.body2" Class="page-subtitle">
            Kelola daftar person in charge.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialogAsync"
               Disabled="@(ViewModel.IsLoading || ViewModel.IsSaving || ViewModel.DatabaseError is not null || ViewModel.AvailableRoles.Count == 0)">
        Tambah PIC
    </MudButton>
</div>

@if (!ViewModel.IsLoading && ViewModel.DatabaseError is null && ViewModel.AvailableRoles.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        Belum ada role. Tambahkan role terlebih dahulu di
        <MudLink Href="/master-roles">Master Roles</MudLink>
        sebelum menambah atau mengedit PIC.
    </MudAlert>
}

<MudPaper Class="section-card project-list-card" Elevation="0">
    <div class="section-heading project-list-heading">
        <div>
            <MudText Typo="Typo.h6" Class="section-title">Daftar PIC</MudText>
            <MudText Typo="Typo.body2" Class="section-subtitle">
                @ViewModel.FilteredPics.Count dari @ViewModel.Pics.Count PIC ditampilkan
            </MudText>
        </div>
        <MudTextField T="string" Value="@ViewModel.SearchText" ValueChanged="OnSearchChanged"
                      Placeholder="Cari nama atau role PIC"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Clearable="true" Class="search-field" aria-label="Cari nama atau role PIC" />
    </div>

    @if (ViewModel.IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        <MudText Class="pa-6" Align="Align.Center" Color="Color.Secondary">
            Memuat data PIC...
        </MudText>
    }
    else if (ViewModel.DatabaseError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-4">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <span>@ViewModel.DatabaseError</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="ViewModel.LoadAsync" Disabled="@ViewModel.IsSaving">
                    Coba lagi
                </MudButton>
            </div>
        </MudAlert>
    }
    else if (ViewModel.FilteredPics.Count == 0)
    {
        <MudText Class="pa-6" Align="Align.Center" Color="Color.Secondary">
            @(ViewModel.Pics.Count == 0
                ? "Belum ada PIC."
                : "Tidak ada PIC yang cocok dengan pencarian.")
        </MudText>
    }
    else
    {
        <MudTable Items="@ViewModel.FilteredPics" Hover="true" Dense="true"
                  Breakpoint="Breakpoint.Sm" Class="project-table">
            <HeaderContent>
                <MudTh>No</MudTh>
                <MudTh>Inisial</MudTh>
                <MudTh>Nama</MudTh>
                <MudTh>ROLE</MudTh>
                <MudTh Class="project-actions-header">Edit</MudTh>
                <MudTh Class="project-actions-header">Delete</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="No">
                    <span class="project-number">@context.No.ToString("D2")</span>
                </MudTd>
                <MudTd DataLabel="Inisial">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Class="master-pic-initials-chip">
                        @GetInitials(context.Nama)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Nama">
                    <div class="project-name-cell">
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Class="project-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </MudAvatar>
                        <MudText Typo="Typo.body2" Class="project-name">@context.Nama</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="Role">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Class="@GetRoleChipClass(context.Role)">
                        @(string.IsNullOrWhiteSpace(context.Role) ? "Belum diisi" : context.Role)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Edit" Class="project-actions-cell">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => OpenEditDialogAsync(context))"
                                   Disabled="@(ViewModel.IsSaving || ViewModel.PendingDeleteId is not null)"
                                   aria-label="@($"Edit {context.Nama}")" />
                </MudTd>
                <MudTd DataLabel="Delete" Class="project-actions-cell">
                    @if (ViewModel.PendingDeleteId == context.Id)
                    {
                        <div class="project-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Check"
                                           Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => ViewModel.DeleteAsync(context.Id))"
                                           Disabled="@ViewModel.IsSaving" aria-label="Konfirmasi hapus" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Default" Size="Size.Small"
                                           OnClick="ViewModel.CancelDelete" Disabled="@ViewModel.IsSaving"
                                           aria-label="Batal menghapus" />
                        </div>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => ViewModel.RequestDelete(context.Id))"
                                       Disabled="@(ViewModel.IsSaving || ViewModel.PendingDeleteId is not null)"
                                       aria-label="@($"Hapus {context.Nama}")" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += OnViewModelStateChanged;
        await ViewModel.LoadAsync();
    }

    private void OnViewModelStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnSearchChanged(string? text) => ViewModel.Search(text);

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return string.Empty;
        }

        var words = name.Split(
            (char[]?)null,
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var initials = new char[3];
        var count = 0;

        foreach (var word in words)
        {
            if (count == initials.Length)
            {
                break;
            }

            initials[count++] = char.ToUpperInvariant(word[0]);
        }

        for (var wordIndex = 0; wordIndex < words.Length && count < initials.Length; wordIndex++)
        {
            for (var characterIndex = 1;
                 characterIndex < words[wordIndex].Length && count < initials.Length;
                 characterIndex++)
            {
                initials[count++] = char.ToUpperInvariant(words[wordIndex][characterIndex]);
            }
        }

        return new string(initials, 0, count);
    }

    private string GetRoleChipClass(string role)
    {
        var index = -1;
        for (var roleIndex = 0; roleIndex < ViewModel.AvailableRoles.Count; roleIndex++)
        {
            if (string.Equals(ViewModel.AvailableRoles[roleIndex], role, StringComparison.Ordinal))
            {
                index = roleIndex;
                break;
            }
        }

        return index < 0
            ? "master-pic-role-chip role-color-unassigned"
            : $"master-pic-role-chip role-color-{index % 8}";
    }

    private async Task OpenAddDialogAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };
        var parameters = new DialogParameters
        {
            ["Roles"] = ViewModel.AvailableRoles.ToArray()
        };
        var dialog = await DialogService.ShowAsync<AddMasterPicDialog>("Tambah PIC", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: MasterPicInput input })
        {
            await ViewModel.CreateAsync(input);
        }
    }

    private async Task OpenEditDialogAsync(MasterPicRow pic)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };
        var parameters = new DialogParameters
        {
            ["Pic"] = pic,
            ["Roles"] = ViewModel.AvailableRoles.ToArray()
        };
        var dialog = await DialogService.ShowAsync<EditMasterPicDialog>("Edit Master PIC", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: MasterPicInput input })
        {
            await ViewModel.UpdateAsync(pic.Id, input);
        }
    }

    public void Dispose() => ViewModel.StateChanged -= OnViewModelStateChanged;
}
